        <mxCell id="panel" value="LXC 106  ·  panel 10.10.10.22 Apache :80  ·  db on 127.0.0.1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152A20;strokeColor=#2F6B4F;fontColor=#D6F7E7;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="872" y="586" width="182" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dmznote" value="No internal walls: these three are neighbours on one bridge, so traffic between them never reaches the firewall. A subnet per service is the next step.  DNS is 1.1.1.1, not AdGuard — AdGuard sits behind the block rule." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="448" y="668" width="606" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jelly" value="LXC 100 · jellyfin  —  deliberately NOT in the DMZ, stays on vmbr0 (not internet-facing)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#141A24;strokeColor=#2A3441;fontColor=#7F8CA0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="820" width="640" height="34" as="geometry" />
        </mxCell>
        <mxCell id="k3s" value="k3s agent  ·  planned" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#141A24;strokeColor=#2A3441;dashed=1;fontColor=#7F8CA0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="864" width="310" height="34" as="geometry" />
        </mxCell>
        <mxCell id="stor" value="Storage  local · local-lvm · hdd-1tb" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#141A24;strokeColor=#2A3441;fontColor=#7F8CA0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="758" y="864" width="312" height="34" as="geometry" />
        </mxCell>
        <mxCell id="rp" value="ENFORCEMENT   ·   all of it lives in one place" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=0;fillColor=#11151D;strokeColor=#2A3441;fontColor=#C9D3DF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="250" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Firewall → Rules → LAN      (LAN = the sealed side)" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=11;fontColor=#9EC1F5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="292" width="390" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r1a" value="1   BLOCK   LAN net  →  192.168.178.0/24        quick       the entire point of the project" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#2E1416;strokeColor=#FF5C5C;fontColor=#FFC9C9;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="316" width="390" height="44" as="geometry" />
        </mxCell>
        <mxCell id="r1b" value="2   PASS     LAN net  →  any       internet, Steam, package updates" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152A20;strokeColor=#4ADE9B;fontColor=#D6F7E7;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="366" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r1c" value="3   PASS     LAN net  →  any   (IPv6)       leftover default — DELETE IT" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#2A2410;strokeColor=#FFB020;fontColor=#FFE9A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="412" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r1n" value="pf reads top to bottom and stops at the first match. Saved at the bottom, rule 1 is not weak — it is inert." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="458" width="390" height="32" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Firewall → Rules → Floating" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=11;fontColor=#9EC1F5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="500" width="390" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r2a" value="PASS   192.168.178.0/24  →  10.10.10.0/24       so I can administer the segment" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152230;strokeColor=#7FC3F5;fontColor=#CFE4FA;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="524" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r2n" value="Looks like a hole. Is not. It permits the OTHER direction, and pf is stateful, so replies to conversations I start flow back with no rule of their own. An attacker cannot start one. A one-way door: I walk in, they cannot walk out." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="570" width="390" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="Firewall → Rules → WAN      (WAN = the house side)" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=11;fontColor=#9EC1F5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="636" width="390" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r3a" value="PASS   192.168.178.0/24  →  This Firewall :80       the GUI. Untick &quot;Block private networks&quot;." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152230;strokeColor=#7FC3F5;fontColor=#CFE4FA;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="660" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="Firewall → NAT → Destination NAT" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=11;fontColor=#9EC1F5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="712" width="390" height="20" as="geometry" />
        </mxCell>
        <mxCell id="r4a" value="source ANY        →  10.10.10.20 / .21     game ports       unavoidable: players come from the internet" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#2A2410;strokeColor=#FFD966;fontColor=#FFE9A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="736" width="390" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r4b" value=".60:8080  src 192.168.178.0/24  →  10.10.10.22:80 .60:9090  src 192.168.178.0/24  →  10.10.10.20:9090       admin only. No FRITZ!Box share exists for these." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152230;strokeColor=#7FC3F5;fontColor=#CFE4FA;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="782" width="390" height="52" as="geometry" />
        </mxCell>
        <mxCell id="r4n" value="NAT reflection ON — my PC shares a subnet with the WAN leg, so its packets do not &quot;arrive from outside&quot; without it.  External port numbers are deliberately not published. See docs/99-security-notes.md" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1200" y="844" width="390" height="74" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="endArrow=classic;html=1;strokeColor=#FFD966;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inet" target="fritz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;html=1;strokeColor=#C9D3DF;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fritz" target="sw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="endArrow=classic;html=1;strokeColor=#C9D3DF;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sw" target="house">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="cable" style="endArrow=classic;html=1;strokeColor=#FFD966;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="sw" target="vmbr0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=classic;html=1;strokeColor=#7FC3F5;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vmbr0" target="opn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="endArrow=classic;html=1;strokeColor=#4ADE9B;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="opn" target="vmbr1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="endArrow=classic;html=1;strokeColor=#4ADE9B;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="vmbr1" target="dmz">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ptrace" value="A player&#39;s packet: 1  arrives at the FRITZ!Box on a game port 2  DNAT #1  →  192.168.178.60 3  crosses the switch into vmbr0 4  OPNsense: DNAT #2  →  10.10.10.20 5  rules decide, then it reaches the game  The reply retraces it automatically — both routers hold state for the conversation." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#11151D;strokeColor=#FFD966;fontColor=#FFE9A8;fontSize=10;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Separation (vmbr1 has no uplink)  +  a chokepoint (every packet meets OPNsense)  ·  both halves are required  ·  when a managed switch arrives, vmbr1 becomes a tagged VLAN and every rule above stays byte-for-byte identical" style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=11;fontColor=#7F8CA0;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="1070" width="1540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eblock" style="endArrow=none;html=1;strokeColor=#FF5C5C;strokeWidth=4;dashed=1;dashPattern=10 6;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="428" y="620" as="sourcePoint" />
            <mxPoint x="332" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="xmark" value="✕" style="text;html=1;fontSize=40;fontColor=#FF5C5C;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Tahoma;" vertex="1" parent="1">
          <mxGeometry x="340" y="596" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="blockbanner" value="THE BLOCK RULE IS THE SECOND LINE OF DEFENCE, NOT THE FIRST  vmbr1 has no uplink, so there is no path from 10.10.10.0/24 into 192.168.178.0/24 to begin with. Delete rule 1 and reachability does not change, because the road does not exist. That is why this design held where two attempts at firewall rules on a flat network did not: a rule can be removed by mistake, a cable that was never plugged in cannot." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Tahoma;fillColor=#2E1416;strokeColor=#FF5C5C;strokeWidth=2;fontColor=#FFC9C9;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="972" width="700" height="86" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
