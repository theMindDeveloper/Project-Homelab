        <mxCell id="amp" value="LXC 107  ·  amp-server 10.10.10.21 games  ·  web :8080  ·  sftp :2223" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152A20;strokeColor=#2F6B4F;fontColor=#D6F7E7;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="586" width="200" height="66" as="geometry" />
