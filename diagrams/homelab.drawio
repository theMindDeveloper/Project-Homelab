        <mxCell id="fritz" value="FRITZ!Box 7590   ·   192.168.178.1  NAT #1 (source NAT for the whole house) DNAT: game ports  →  192.168.178.60 static route: 10.10.10.0/24  via  .60 Exposed Host: UNTICKED" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#1B2430;strokeColor=#FFD966;fontColor=#E7EDF5;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
