        <mxCell id="housenote" value="None of this changed. Nothing here routes through OPNsense." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pve2" value="P2   ·   node pve2   ·   192.168.178.77:8006   ·   32 GB   ·   the only node with vmbr1" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=0;fillColor=#0F141C;strokeColor=#FFB020;strokeWidth=2;fontColor=#FFD966;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="700" height="830" as="geometry" />
        </mxCell>
        <mxCell id="vmbr0" value="bridge  vmbr0        bridge-ports  nic0   ←  the real NIC, reaches the house" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#16202C;strokeColor=#7FC3F5;fontColor=#9EC1F5;fontSize=11;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="640" height="46" as="geometry" />
        </mxCell>
        <mxCell id="opn" value="VM 200  ·  OPNsense 26.7  ·  FreeBSD  ·  2 GB  ·  2 cores the only door between the two networks" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#3D2E00;strokeColor=#FFD966;strokeWidth=2;fontColor=#FFE9A8;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="580" height="56" as="geometry" />
        </mxCell>
        <mxCell id="wanleg" value="WAN   vtnet0  →  vmbr0 192.168.178.60/24 gw 192.168.178.1  ·  DHCP off" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#1B2430;strokeColor=#7FC3F5;fontColor=#9EC1F5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="344" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="lanleg" value="LAN   vtnet1  →  vmbr1 10.10.10.1/24 no gateway  ·  DHCP off" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#1B2430;strokeColor=#4ADE9B;fontColor=#84E9BC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="344" width="280" height="62" as="geometry" />
        </mxCell>
        <mxCell id="opnnote" value="FreeBSD, so it cannot be an LXC. And a firewall containing a compromised guest should not borrow the kernel it is protecting against." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="460" y="412" width="580" height="34" as="geometry" />
        </mxCell>
        <mxCell id="vmbr1" value="bridge  vmbr1        bridge-ports  NONE        ·        NO CABLE" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#16202C;strokeColor=#4ADE9B;strokeWidth=2;dashed=1;dashPattern=8 6;fontColor=#84E9BC;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="462" width="640" height="46" as="geometry" />
        </mxCell>
        <mxCell id="vmbr1n" value="This one line is the separation. A rule can be deleted by mistake; an absent cable cannot." style="text;html=1;whiteSpace=wrap;fontFamily=Tahoma;align=left;verticalAlign=top;fontSize=10;fontColor=#8A96A6;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="510" width="640" height="20" as="geometry" />
        </mxCell>
        <mxCell id="dmz" value="SEALED GAME SEGMENT   10.10.10.0/24   ·   everything the internet can reach" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=0;fillColor=#101A16;strokeColor=#4ADE9B;strokeWidth=2;fontColor=#4ADE9B;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="542" width="640" height="260" as="geometry" />
        </mxCell>
        <mxCell id="wings" value="LXC 105  ·  wings 10.10.10.20 games  ·  api :9090  ·  sftp :2022" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#152A20;strokeColor=#2F6B4F;fontColor=#D6F7E7;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="448" y="586" width="200" height="66" as="geometry" />
