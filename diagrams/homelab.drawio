        <mxCell id="sw" value="TP-Link TL-SG108   ·   unmanaged no VLAN tagging — the reason this DMZ is software" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fontFamily=Tahoma;verticalAlign=middle;align=center;fillColor=#1B2430;strokeColor=#3A4657;fontColor=#C9D3DF;fontSize=11;" vertex="1" parent="1">
