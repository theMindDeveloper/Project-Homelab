# Copy to .env and fill in. .env is gitignored.
# Generate each password with:  openssl rand -base64 32

POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=

REDIS_PASSWORD=

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# Where user files live on the container's filesystem. Put this on the
# largest disk you have; it is the volume that grows.
NEXTCLOUD_DATA_DIR=/srv/nextcloud/data

# Comma separated, no scheme, no trailing slash.
NEXTCLOUD_TRUSTED_DOMAINS=cloud.example.com

# Full external URL, with scheme.
NEXTCLOUD_URL=https://cloud.example.com

# The address of the reverse proxy, as Nextcloud sees it.
TRUSTED_PROXIES=192.168.178.178
