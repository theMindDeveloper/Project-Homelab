# Copy to game-exporter.env and fill in. chmod 600. Gitignored.
# See runbooks/25-game-server-monitoring.md. Leave a URL empty to skip that panel.
# AMP: base URL WITHOUT /API, and an AMP user that may list instances.
AMP_URL=http://10.10.10.21:8080
AMP_USER=change-me-amp-user
AMP_PASS=change-me-amp-password
# Pterodactyl: a CLIENT API key (Account -> API Credentials) of a non-admin user,
# limited to the IP of the machine this runs on. The full key is ptlc_ + ~43 chars.
PTERO_URL=http://10.10.10.22
PTERO_KEY=ptlc_change-me-the-full-key
