# Copy to pve-exporter.env and fill in. chmod 600. Gitignored.
# Token of a read-only Proxmox user (role PVEAuditor), see runbooks/10-monitoring-stack.md.
PVE_USER=prometheus@pve
PVE_TOKEN_NAME=exporter
PVE_TOKEN_VALUE=change-me
# Proxmox uses a self-signed certificate on :8006.
PVE_VERIFY_SSL=false
