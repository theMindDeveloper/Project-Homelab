# Copy to alerting.env and fill in. chmod 600. Gitignored.
# Your OWN Telegram bot (made with @BotFather) - see runbooks/23-alerts-to-telegram.md.
# The token can only send messages as that bot; /revoke in @BotFather replaces it.
TELEGRAM_BOT_TOKEN=123456789:change-me
# Your chat with the bot. Send the bot any message first, then read it from
#   https://api.telegram.org/bot<TOKEN>/getUpdates   ("chat":{"id": ...})
TELEGRAM_CHAT_ID=123456789
