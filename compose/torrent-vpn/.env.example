# Copy to .env and fill in. .env is gitignored.
# In the UGOS Docker "Project" UI there is no .env, so the values go straight
# into the compose file there. That file never comes back into this repository.

# From the Mullvad WireGuard .conf file ([Interface] section)
WIREGUARD_PRIVATE_KEY=
# IPv4 part of "Address", including /32, e.g. 10.66.123.45/32
WIREGUARD_ADDRESSES=

# Folder on the NAS that holds gluetun/, config/ and downloads/
# Shape: /volumeN/<shared folder>/torrents
TORRENT_DIR=/volume3/6TB_1/torrents

# `id` on the NAS: uid -> PUID, gid -> PGID
PUID=1000
PGID=10
