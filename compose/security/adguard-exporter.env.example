# Copy to adguard-exporter.env and fill in. chmod 600. Gitignored.
# An AdGuard Home user (AdGuard -> Settings -> General has no roles; any login works).
# One value per server, comma-separated if you have several.
ADGUARD_USERNAMES=change-me-adguard-user
ADGUARD_PASSWORDS=change-me-adguard-password
